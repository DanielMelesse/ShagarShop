# Local Postgres (matches docker-compose.yml)
DATABASE_URL="postgresql://sheger:sheger@localhost:5432/shegershop?schema=public"

NEXTAUTH_SECRET="change-me-run-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Public site URL (absolute links, Capacitor, emails). Production example:
# NEXT_PUBLIC_APP_URL="https://shegershop.com"
# CAPACITOR_SERVER_URL="https://shegershop.com"

# --- Cloudflare R2 / S3 uploads (required on Railway; optional locally) ---
# S3_BUCKET="shegershop-uploads"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
# S3_PUBLIC_URL="https://cdn.shegershop.com"
# S3_REGION="auto"
# S3_FORCE_PATH_STYLE="true"

# SMS order updates: console (default/dev) | africastalking | twilio
SMS_PROVIDER="console"
# Set to 0 to disable sending without removing provider config
# SMS_ENABLED="1"

# Africa's Talking (Ethiopia / East Africa)
# AFRICASTALKING_USERNAME="sandbox"
# AFRICASTALKING_API_KEY=""
# AFRICASTALKING_FROM=""
# AFRICASTALKING_SANDBOX="1"

# Twilio
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM="+1XXXXXXXXXX"

# Global payment override: mock | live (optional)
# PAYMENT_MODE="mock"

# --- Chapa merchant API (separate from Telebirr) ---
# Without CHAPA_SECRET_KEY, Chapa checkout runs in mock mode.
# CHAPA_MODE="mock"
# CHAPA_MODE="live"
# CHAPA_SECRET_KEY="CHASECK_TEST-xxxxxxxx"
# CHAPA_PUBLIC_KEY="CHAPUBK_TEST-xxxxxxxx"

# --- Telebirr merchant API (Ethio Telecom H5 C2B — separate from Chapa) ---
# Get these from https://developer.ethiotelecom.et/
# Without these credentials, Telebirr checkout runs in mock mode.
# TELEBIRR_MODE="mock"
# TELEBIRR_MODE="live"
# TELEBIRR_ENVIRONMENT="test"   # or production
# TELEBIRR_FABRIC_APP_ID=""
# TELEBIRR_APP_SECRET=""
# TELEBIRR_MERCHANT_APP_ID=""
# TELEBIRR_MERCHANT_CODE=""
# TELEBIRR_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# Optional: TELEBIRR_PUBLIC_KEY for notify/return signature checks
# TELEBIRR_NOTIFY_URL="https://shegershop.com/api/payments/telebirr/webhook"
# TELEBIRR_REDIRECT_URL="https://shegershop.com/checkout/result?via=telebirr"

# FCM push (optional)
# FIREBASE_SERVER_KEY=""
