generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  BUYER
  SELLER
  DELIVERY
  ADMIN
}

model User {
  id              String           @id @default(cuid())
  phone           String           @unique
  email           String?          @unique
  passwordHash    String
  name            String
  role            UserRole         @default(BUYER)
  createdAt       DateTime         @default(now())
  orders          Order[]
  products        Product[]
  sellerProfile   SellerProfile?
  deliveryProfile DeliveryProfile?
  deliveries      OrderItem[]      @relation("DeliveryAssignments")
  cart            Cart?
  mobileRefreshTokens MobileRefreshToken[]
  pushDevices     PushDevice[]
}

model SellerProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shopName    String
  location    String
  licenseUrl  String
  category    String
  completedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
}

model DeliveryProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleType String
  serviceArea String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([serviceArea])
  @@index([active])
}

model Product {
  id          String      @id
  name        String
  description String
  price       Float
  category    String
  image       String
  images      String[]    @default([])
  rating      Float       @default(0)
  reviewCount Int         @default(0)
  stock       Int         @default(0)
  featured    Boolean     @default(false)
  size        String?
  shippingTier      String   @default("standard")
  extraShippingBirr Float    @default(0)
  condition         String   @default("new")
  sellerId    String?
  seller      User?       @relation(fields: [sellerId], references: [id])
  orderItems  OrderItem[]
  cartItems   CartItem[]

  @@index([featured])
  @@index([category])
  @@index([sellerId])
}

model Order {
  id           String      @id @default(cuid())
  userId       String?
  user         User?       @relation(fields: [userId], references: [id])
  /** awaiting_payment | placed | cancelled */
  status       String      @default("placed")
  /** pending | paid | cod | failed | cancelled */
  paymentStatus String     @default("paid")
  /** chapa | telebirr | cod | demo | none */
  paymentMethod String     @default("demo")
  /** Unique Chapa tx_ref (or mock ref). */
  paymentTxRef  String?    @unique
  paymentRef    String?
  paidAt        DateTime?
  subtotal     Float
  shipping     Float
  tax          Float       @default(0)
  total        Float
  shippingName String
  address      String
  city         String
  zip          String
  createdAt    DateTime    @default(now())
  items        OrderItem[]

  @@index([userId])
  @@index([createdAt])
  @@index([paymentStatus])
  @@index([status])
}

model OrderItem {
  id                 String    @id @default(cuid())
  orderId            String
  order              Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId          String
  product            Product   @relation(fields: [productId], references: [id])
  quantity           Int
  priceAtPurchase    Float
  productName        String
  fulfillmentStatus  String    @default("pending")
  /** Package barcode assigned by seller when marking ready for courier pickup. */
  trackingCode       String?   @unique
  /** Snapshot: 0 during promo, else platform rate (e.g. 0.1). */
  commissionRate     Float     @default(0)
  commissionAmount   Float     @default(0)
  /** lineTotal − commissionAmount at purchase. */
  sellerEarnings     Float     @default(0)
  deliveryId         String?
  delivery           User?     @relation("DeliveryAssignments", fields: [deliveryId], references: [id])
  deliveryAssignedAt DateTime?
  deliveredAt        DateTime?

  @@index([fulfillmentStatus])
  @@index([deliveryId])
  @@index([trackingCode])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id           String  @id @default(cuid())
  cartId       String
  cart         Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId    String
  product      Product @relation(fields: [productId], references: [id])
  quantity     Int
  selectedSize String?

  @@unique([cartId, productId, selectedSize])
  @@index([cartId])
}

model MobileRefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model PushDevice {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}
