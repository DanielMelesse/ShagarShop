generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  BUYER
  SELLER
}

model User {
  id           String    @id @default(cuid())
  phone        String    @unique
  email        String?   @unique
  passwordHash String
  name         String
  role         UserRole  @default(BUYER)
  createdAt    DateTime  @default(now())
  orders       Order[]
  products     Product[]
}

model Product {
  id          String      @id
  name        String
  description String
  price       Float
  category    String
  image       String
  rating      Float       @default(0)
  reviewCount Int         @default(0)
  stock       Int         @default(0)
  featured    Boolean     @default(false)
  size        String?
  sellerId    String?
  seller      User?       @relation(fields: [sellerId], references: [id])
  orderItems  OrderItem[]

  @@index([featured])
  @@index([category])
  @@index([sellerId])
}

model Order {
  id           String      @id @default(cuid())
  userId       String?
  user         User?       @relation(fields: [userId], references: [id])
  status       String      @default("placed")
  subtotal     Float
  shipping     Float
  total        Float
  shippingName String
  address      String
  city         String
  zip          String
  createdAt    DateTime    @default(now())
  items        OrderItem[]

  @@index([userId])
  @@index([createdAt])
}

model OrderItem {
  id              String  @id @default(cuid())
  orderId         String
  order           Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product @relation(fields: [productId], references: [id])
  quantity        Int
  priceAtPurchase Float
  productName     String
}
