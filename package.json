{
  "name": "shagar-shop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "bash scripts/ensure-env.sh && bash scripts/prisma.sh generate",
    "dev": "bash scripts/next.sh dev",
    "build": "bash scripts/prisma.sh generate && bash scripts/next.sh build",
    "start": "bash scripts/next.sh start",
    "lint": "bash scripts/next.sh lint",
    "clean": "rm -rf .next out",
    "db:up": "bash scripts/db-up.sh",
    "db:ping": "bash scripts/db-ping.sh",
    "db:down": "docker compose down",
    "db:migrate": "bash scripts/prisma.sh migrate dev",
    "db:migrate:deploy": "bash scripts/prisma.sh migrate deploy",
    "db:push": "bash scripts/prisma.sh db push",
    "db:seed": "bun prisma/seed.ts",
    "images:recompress": "bun scripts/recompress-product-images.ts",
    "predb:setup": "bash scripts/ensure-env.sh && bash scripts/check-postgres-env.sh",
    "db:setup": "bash scripts/prisma.sh generate && bash scripts/prisma.sh migrate deploy && bun prisma/seed.ts",
    "setup": "bun install --ignore-scripts && bun run db:setup",
    "db:generate": "bash scripts/prisma.sh generate",
    "test:payments": "bun scripts/test-payments-local.ts",
    "test:payments:http": "bun scripts/test-payments-http.ts",
    "test:courier-login": "bun scripts/test-courier-login.ts",
    "test:seller-login": "bun scripts/test-seller-login.ts",
    "test:package-tracking": "bun scripts/test-package-tracking-code.ts"
  },
  "prisma": {
    "seed": "bun prisma/seed.ts"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "packageManager": "bun@1.3.14",
  "dependencies": {
    "@melakudemeke/telebirr-js": "^3.1.0",
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.2",
    "html5-qrcode": "^2.3.8",
    "leaflet": "^1.9.4",
    "next": "^15.3.3",
    "next-auth": "^4.24.11",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "eslint": "^9.27.0",
    "eslint-config-next": "^15.3.3",
    "postcss": "^8.5.3",
    "prisma": "6.19.3",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.8.3"
  }
}
